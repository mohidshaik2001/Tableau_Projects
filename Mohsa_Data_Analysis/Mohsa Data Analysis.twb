    <worksheet name='KPI Profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Profits&#10;</run>
            <run fontname='Tableau Bold' fontsize='24'><![CDATA[<[federated.0jrxjab129si8m1czdj530nh74pa].[sum:Calculation_4300233960863326208:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='14'><![CDATA[<[federated.0jrxjab129si8m1czdj530nh74pa].[sum:Calculation_4300233960863354881:qk]>]]></run>
            <run>Æ </run>
            <run fontcolor='#b4b4b4' fontsize='12'>vs .PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cost_to_company+' name='federated.0jrxjab129si8m1czdj530nh74pa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='real' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024.0'>
              <calculation class='tableau' formula='2024.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jrxjab129si8m1czdj530nh74pa'>
            <column aggregation='Sum' caption='Profit' datatype='real' default-format='c&quot;₹&quot;#,##0,,,.0B;-&quot;₹&quot;#,##0,,,.0B' name='[Calculation_2896377578306457600]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_amount]-[total_company_cost]' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='real' name='[Calculation_2896377578642460675]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='real' name='[Calculation_2896377578642522116]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='CY Profit' datatype='real' name='[Calculation_2896377578643378184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1] THEN [Calculation_2896377578306457600]&#10;END' />
            </column>
            <column caption='PY Profit' datatype='real' name='[Calculation_2896377578643587081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1]-1 THEN [Calculation_2896377578306457600]&#10;END' />
            </column>
            <column caption='%Diff Profit' datatype='real' name='[Calculation_2896377578643673098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([Calculation_2896377578643378184])&gt;0)AND (SUM([Calculation_2896377578643587081])&lt;0)&#10;then ABS((SUM([Calculation_2896377578643378184])-SUM([Calculation_2896377578643587081]))/SUM([Calculation_2896377578643587081]))&#10;ELSE&#10;(SUM([Calculation_2896377578643378184])-SUM([Calculation_2896377578643587081]))/SUM([Calculation_2896377578643587081])&#10;END' />
            </column>
            <column caption='{SUM([CY Profit])}' datatype='real' name='[Calculation_4300233960863326208]' role='measure' type='quantitative' user:unnamed='KPI Profit'>
              <calculation class='tableau' formula='{SUM([Calculation_2896377578643378184])}' />
            </column>
            <column caption='{[%Diff Profit]}' datatype='real' name='[Calculation_4300233960863354881]' role='measure' type='quantitative' user:unnamed='KPI Profit'>
              <calculation class='tableau' formula='{[Calculation_2896377578643673098]}' />
            </column>
            <column caption='MIN/MAX Profit' datatype='real' name='[Calculation_4300233960864202754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_2896377578643378184])=WINDOW_MAX(SUM([Calculation_2896377578643378184]))&#10;THEN SUM([Calculation_2896377578643378184])&#10;ELSEIF SUM([Calculation_2896377578643378184])=WINDOW_MIN(SUM([Calculation_2896377578643378184]))&#10;THEN SUM([Calculation_2896377578643378184])&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
