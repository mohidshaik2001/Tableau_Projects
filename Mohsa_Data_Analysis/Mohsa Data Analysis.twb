            </column>
            <column caption='MIN/MAX sales' datatype='real' name='[Calculation_3835096560891740163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_2896377578642673669])=WINDOW_MAX(SUM([Calculation_2896377578642673669]))&#10;THEN sum([Calculation_2896377578642673669])&#10;ELSEIF  SUM([Calculation_2896377578642673669])=WINDOW_MIN(SUM([Calculation_2896377578642673669]))&#10;THEN SUM([Calculation_2896377578642673669])&#10;END'>
