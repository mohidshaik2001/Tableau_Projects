              <calculation class='tableau' formula='{SUM([Calculation_2896377578642808838])}' />
            </column>
            <column caption='{[%Diff Sales]}' datatype='real' name='[Calculation_3835096560885698562]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
