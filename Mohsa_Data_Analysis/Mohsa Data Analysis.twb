    <worksheet name='KPI sales per Customer'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Sales Per Customer&#10;</run>
            <run fontname='Tableau Bold' fontsize='24'><![CDATA[<[federated.0jrxjab129si8m1czdj530nh74pa].[sum:Calculation_4675721580171370498:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='14'><![CDATA[<[federated.0jrxjab129si8m1czdj530nh74pa].[sum:Calculation_4675721580171390979:qk]> ]]></run>
            <run fontcolor='#b4b4b4' fontsize='12'>vs.PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cost_to_company+' name='federated.0jrxjab129si8m1czdj530nh74pa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='real' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024.0'>
              <calculation class='tableau' formula='2024.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jrxjab129si8m1czdj530nh74pa'>
            <column aggregation='Sum' caption='Current Year' datatype='real' name='[Calculation_2896377578642460675]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='real' name='[Calculation_2896377578642522116]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='CY Sales' datatype='real' name='[Calculation_2896377578642673669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1] THEN [order_amount]&#10;END' />
            </column>
            <column caption='PY Sales' datatype='real' name='[Calculation_2896377578642808838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1]-1 THEN [order_amount]&#10;END' />
            </column>
            <column aggregation='CountD' caption='CY Customers' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_3329356394782736388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1] THEN&#10;[customer_id] END' />
            </column>
            <column aggregation='CountD' caption='PY Customers' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_3329356394783072261]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([order_date])=[Parameters].[Parameter 1]-1 THEN [customer_id]&#10;END' />
            </column>
            <column caption='CY Sales Per Customer' datatype='real' name='[Calculation_3329356394784337927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_2896377578642673669])/COUNTD([Calculation_3329356394782736388]))' />
            </column>
            <column caption='PY Sales per Customer' datatype='real' name='[Calculation_3329356394784665608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2896377578642808838])/COUNTD([Calculation_3329356394783072261])' />
            </column>
            <column caption='%Diff Sales Per Customer' datatype='real' name='[Calculation_4675721580168089600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([Calculation_2896377578642673669])/COUNTD([Calculation_3329356394782736388]))-&#10;(SUM([Calculation_2896377578642808838])/COUNTD([Calculation_3329356394783072261]))&#10;)&#10;/(SUM([Calculation_2896377578642808838])/COUNTD([Calculation_3329356394783072261]))' />
