            </column>
            <column caption='KPI CY profit % Less than PY profit %' datatype='string' name='[Calculation_4202351037405708288]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM([Calculation_2896377578643378184]) / SUM([Calculation_2896377578642673669])) * 100 &#10;   &lt; (SUM([Calculation_2896377578643587081]) / SUM([Calculation_2896377578642808838])) * 100&#10;THEN &apos;⬤&apos;&#10;END' />
